<Window x:Class="CloudPad.Receiver.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CloudPad Receiver" Height="720" Width="820" MinHeight="600" MinWidth="700" Background="#10151F">
 <ScrollViewer><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="CloudPad Receiver" FontSize="30" FontWeight="Bold" Foreground="#FAFAFA"/>
  <Grid Grid.Row="1" Margin="0,22,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="StatusText" Foreground="#6DE1A9" FontSize="18"/><TextBlock x:Name="LocalIpText" Foreground="White" Margin="0,10,0,0"/><TextBlock x:Name="TailIpText" Foreground="White" Margin="0,6,0,0"/><TextBlock x:Name="DriverText" Foreground="#FFCA70" Margin="0,10,0,0" TextWrapping="Wrap"/><Button Content="Setup Instructions" Width="150" HorizontalAlignment="Left" Margin="0,8" Click="Setup_Click"/></StackPanel>
   <Border Grid.Column="1" Background="#192231" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="PAIRING PIN" Foreground="#9CA9B8"/><TextBlock x:Name="PinText" FontSize="38" FontFamily="Consolas" Foreground="White"/><Button Content="Generate new PIN" Click="NewPin_Click"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <GroupBox Header="Connection" Foreground="White" Margin="0,0,8,0"><StackPanel Margin="12"><TextBlock x:Name="PhoneText"/><TextBlock x:Name="PingText" Margin="0,6"/><TextBlock x:Name="RateText"/><StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="Start Server" Click="Start_Click" Margin="0,0,8,0"/><Button Content="Stop Server" Click="Stop_Click"/></StackPanel></StackPanel></GroupBox>
   <GroupBox Grid.Column="1" Header="Input tester" Foreground="White" Margin="8,0,0,0"><StackPanel Margin="12"><TextBlock x:Name="ButtonsText" TextWrapping="Wrap"/><TextBlock x:Name="SticksText" Margin="0,8"/><TextBlock x:Name="TriggersText"/></StackPanel></GroupBox>
  </Grid>
  <GroupBox Grid.Row="3" Header="Settings" Foreground="White" Margin="0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock Text="Port"/><TextBox x:Name="PortBox" Grid.Column="1" Margin="8,3"/><TextBlock Grid.Row="1" Text="Packet timeout (ms)"/><TextBox x:Name="TimeoutBox" Grid.Row="1" Grid.Column="1" Margin="8,3"/>
   <StackPanel Grid.Row="2" Grid.ColumnSpan="2"><CheckBox x:Name="AutoStartCheck" Content="Auto start server"/><CheckBox x:Name="StartMinCheck" Content="Start minimized"/><CheckBox x:Name="WindowsStartCheck" Content="Start CloudPad with Windows"/><CheckBox x:Name="LoggingCheck" Content="Enable logging"/></StackPanel>
   <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Save settings" Click="Save_Click" Margin="0,12,0,0"/>
  </Grid></GroupBox>
 </Grid></ScrollViewer>
</Window>
